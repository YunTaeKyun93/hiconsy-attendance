# PostgreSQL (docker-compose와 백엔드가 함께 사용)
DB_HOST=localhost
DB_PORT=5432
DB_USER=attendance
DB_PASSWORD=attendance
DB_NAME=attendance

# 백엔드
PORT=3000
NODE_ENV=development

# 연구실 IP 목록 (쉼표 구분)
LAB_IPS=127.0.0.1,::1

# 로그인 토큰(JWT) 서명 키. npm run setup이 .env를 만들 때 무작위 값으로 채운다.
JWT_SECRET=
# 로그인 유지 시간(시간 단위, 주입한 시계 기준).
# 개발 모드 시계를 하루씩 옮겨도 로그인이 유지되도록 개발용은 168(7일). 운영은 12 권장(값이 없으면 12).
JWT_EXPIRES_HOURS=168

# 공공데이터포털 한국천문연구원 특일 정보 API 서비스 키 (npm run sync:holidays에서만 사용)
HOLIDAY_API_KEY=
